# Unity project lives in game/ (standard Unity .gitignore, rooted at game/)
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Bb]uild*/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/
/game/[Mm]emoryCaptures/
/game/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/game/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/MD/Consulo solution and project files
/game/ExportedObj/
/game/.consulo/
/game/*.csproj
/game/*.unityproj
/game/*.sln
/game/*.slnx
/game/*.suo
/game/*.tmp
/game/*.user
/game/*.userprefs
/game/*.pidb
/game/*.booproj
/game/*.svd
/game/*.pdb
/game/*.mdb
/game/*.opendb
/game/*.VC.db
/game/.vs/
/game/.vscode/
/game/.idea/
.vs/
.idea/

# Unity3D generated meta files
/game/*.pidb.meta
/game/*.pdb.meta
/game/*.mdb.meta

# Unity3D generated file on crash reports
/game/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/game/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/game/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store
Thumbs.db
